<?xml version="1.0" encoding="utf-8"?>
<!--
  Cinema for other apps (car/OpenInCinemaActivity.kt): a video sent with "Open with", or a link with
  "Share", opens in Cinema on the car's screen. Said on the phone, in a short message.
-->
<resources>
    <!-- The car is connected: the video plays, or the page opens, in Cinema now. -->
    <string name="open_with_opening">Ouverture dans Cinema, sur l’écran de la voiture.</string>
    <!-- The car is connecting: it opens once the car's screen is there. -->
    <string name="open_with_soon">S’ouvre dans Cinema, sur l’écran de la voiture, dès que la voiture est connectée.</string>
    <!-- No car connected: nothing is kept for later. -->
    <string name="open_with_no_car">myCar n’est pas connecté à la voiture. Connectez-le, puis renvoyez ceci : ça s’ouvre dans Cinema, sur l’écran de la voiture.</string>
    <!-- What was sent has no video and no web address (a text, a file). -->
    <string name="open_with_nothing">Rien ici que Cinema puisse ouvrir : envoyez-lui une vidéo, ou le lien d’une page web.</string>
    <!-- The name of a video sent without one: in the player's bar, and in "Continue" on Cinema's tiles. -->
    <string name="open_with_untitled">Vidéo</string>
</resources>
