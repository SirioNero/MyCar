    <string name="setup_cert_title">车机证书</string>
    <string name="setup_cert_body">汽车只和持有其信任证书的手机通信。myCar 不自带证书：它会从 GitHub 上的开源项目下载公开证书（每个约 10 KB）。如果你的汽车拒绝了其中一个，myCar 会尝试下一个。</string>
    <string name="setup_cert_get">获取证书</string>
    <string name="setup_cert_getting">正在获取证书…</string>
    <string name="setup_cert_own_file">使用我自己的文件</string>
    <string name="setup_cert_wrong_file">下载的某个文件不是预期的证书，所以 myCar 没有使用它。请稍后重试。</string>
    <string name="setup_cert_no_download">无法下载证书。请检查网络连接，然后重试。</string>
    <string name="setup_cert_some_ready">已获取 %1$d 个，共 %2$d 个。%3$s 已就绪；其他证书可以稍后在“设置”中获取。</string>
    <string name="setup_cert_ready_own">已就绪：你自己的证书。</string>
    <plurals name="setup_cert_ready_spares">
        <item quantity="other">已就绪：%1$s。备用：%2$s。</item>
    </plurals>
    <string name="setup_cert_ready_one">已就绪：%1$s。</string>
    <string name="setup_cert_ready">已就绪。</string>
    <string name="setup_cert_password_title">证书密码</string>
    <string name="setup_cert_password_label">密码</string>
    <string name="setup_cert_password_hint">如果文件没有密码，请留空。</string>
    <string name="setup_cert_password_use">使用</string>
    <string name="setup_cert_password_wrong">密码错误，或者不是含私钥的 .p12 文件。</string>

    <string name="setup_mycar_on_title">为汽车开启 myCar</string>
    <string name="setup_mycar_on_body">它在“设置”中已关闭，所以汽车无法连接它。</string>
    <string name="setup_mycar_on_button">开启</string>

    <string name="setup_aa_title">关闭 Android Auto</string>
    <string name="setup_aa_off">Android Auto 已关闭。</string>
    <string name="setup_aa_kept">插上数据线时，你会选择 myCar。</string>
    <string name="setup_aa_body">Android Auto 已开启，它可能会抢在 myCar 之前占用汽车的连接。在打开的页面上，依次点按“停用”和“确定”，然后返回这里。</string>
    <string name="setup_aa_open">打开 Android Auto</string>
    <string name="setup_aa_no_disable">没有“停用”按钮？</string>
    <string name="setup_aa_keep_body">那就保留它。插上数据线时，Android 会询问要打开哪个应用：选择 myCar，然后点按“始终”。如果 Android Auto 自己打开了，说明它被设为始终打开：在它的应用信息中点按“默认打开”，然后点按“清除默认偏好设置”。</string>
    <string name="setup_aa_keep">保留 Android Auto</string>

    <string name="setup_drive_title">通话、地图和音乐</string>
    <string name="setup_drive_allowed">已允许。</string>
    <string name="setup_drive_blocked">Android 不会再询问以下权限：%1$s。请在 myCar 的应用信息中，于“权限”下开启。</string>
    <string name="setup_drive_skipped">已跳过。准备好后点按“允许”。</string>
    <string name="setup_drive_still_off">仍未开启：%1$s。</string>
    <string name="setup_drive_body">汽车会显示来电者和最近通话，并能拨打你的联系人；地图能知道你在哪里；不用蓝牙也能把音乐传到车上。Android 会询问几次：每次都点按“允许”。myCar 只读取信息，并且只在你点按麦克风时才会听。</string>
    <string name="setup_group_phone">电话</string>
    <string name="setup_group_call_logs">通话记录</string>
    <string name="setup_group_contacts">通讯录</string>
    <string name="setup_group_location">位置信息</string>
    <string name="setup_group_microphone">麦克风</string>
    <string name="setup_group_nearby_devices">附近的设备</string>

    <string name="setup_more_count">更多（%1$d）</string>
    <string name="setup_more_show_more">显示更多</string>
    <string name="setup_more_show_less">收起</string>
    <string name="setup_more_later">这些都可以以后再设置。</string>
    <string name="setup_messages_title">消息</string>
    <string name="setup_messages_body">汽车会显示你的消息、朗读消息，并让你回复。在打开的页面中开启 myCar。如果 Android 提示这是受限制的设置：打开 myCar 的应用信息，点按 ⋮，然后点按“允许受限制的设置”，再试一次。</string>
    <string name="setup_messages_open">打开通知使用权</string>
    <string name="setup_calendar_title">日历</string>
    <string name="setup_calendar_body">车机屏幕会显示你的下一个日程。myCar 只读取你的日历。</string>
    <string name="setup_notifications_title">通知</string>
    <string name="setup_notifications_body">让 myCar 显示它已连接到汽车，在发送手机声音时提供“停止”按钮，并在有更新时通知你。</string>
    <string name="setup_screening_title">过滤陌生来电</string>
    <string name="setup_screening_body">连接汽车时，通讯录以外的号码来电会先等几秒再响铃，让你能在车上拒接。</string>
    <string name="setup_screening_button">设置</string>
    <string name="setup_audio_title">车载音频</string>
    <string name="setup_audio_body">音乐如何传到车上。无论哪种方式，通话都通过蓝牙。</string>
    <string name="setup_usage_title">帮助其他司机</string>

