    <string name="intro_voice_failed">下载失败，点按重试</string>
    <string name="intro_voice_download">下载语音，%1$d MB</string>
    <string name="intro_voice_sample">“%1$s”</string>

    <string name="activity_toast_no_call_screening">这部手机不允许应用过滤来电。</string>
    <string name="activity_toast_already_screening">myCar 已在过滤陌生来电。</string>
    <string name="activity_toast_music_pauses_sharing">共享手机屏幕时，手机音乐会暂停</string>
    <string name="activity_toast_open_for_music">在手机上打开 myCar，即可把手机音乐发送到车上</string>
    <string name="activity_toast_open_for_sharing">在手机上打开 myCar，即可共享手机屏幕</string>
    <string name="activity_status_no_car_title">无法连接到汽车</string>
    <string name="activity_status_no_car_detail">Android 检测到了数据线，但没有检测到汽车。请拔下数据线，然后重新插上。</string>
    <string name="activity_status_unplugged_title">汽车未连接</string>
    <string name="activity_status_unplugged_detail">在 myCar 建立连接之前，数据线被拔掉了。请重新插上。</string>
    <string name="activity_status_taken_title">汽车被其他应用占用</string>
    <string name="activity_status_taken_detail">另一个应用抢先占用了汽车的连接。如果 Android 询问要为汽车打开哪个应用，请选择 myCar。</string>
</resources>
