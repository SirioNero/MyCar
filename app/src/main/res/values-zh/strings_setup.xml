    <string name="setup_guide_optional">可选</string>
    <string name="setup_guide_already_allowed">已允许。</string>
    <string name="setup_guide_skip_for_now">暂时跳过</string>
    <string name="setup_guide_usage_title">帮助其他司机。</string>
    <string name="setup_guide_safety_title">安全驾驶。</string>
    <string name="setup_guide_safety_body">myCar 是非官方应用。没有任何汽车制造商开发或检查过它，它可能会毫无预兆地出问题。请在出发前设置好，开车时专注路况。</string>
    <string name="setup_guide_mic_title">麦克风。</string>
    <string name="setup_guide_mic_body">myCar 用它把你的音乐发送到车上，并在你提出请求或回复消息时听你说话。你说的话只留在手机上。</string>
    <string name="setup_guide_location_title">位置信息。</string>
    <string name="setup_guide_location_body">车上的地图和附近搜索都需要它。没有它，仪表盘上不会显示地图。</string>
    <string name="setup_guide_calendar_title">日历。</string>
    <string name="setup_guide_calls_title">通话和联系人。</string>
    <string name="setup_guide_calls_body">汽车会显示来电者的名字，车上的“电话”应用可以拨打号码或呼叫你的联系人。myCar 只读取这些信息。</string>
    <string name="setup_guide_nearby_title">附近的设备。</string>
    <string name="setup_guide_nearby_body">首次插上数据线时，myCar 会提议将手机与汽车配对，让通话通过车内扬声器播放。</string>
    <string name="setup_guide_nearby_body_home">首次插上数据线时，myCar 会提议将手机与汽车配对，让通话通过车内扬声器播放。同一项权限还能让 Plancia 和 Xonos 访问你家庭网络中的 Home Assistant 和 Music Assistant。</string>
    <string name="setup_guide_notifications_title">通知。</string>
    <string name="setup_guide_notifications_body">myCar 连接时会显示一条带停止按钮的通知。如果不允许，Android 会隐藏它。</string>
    <string name="setup_guide_messages_title">消息。</string>
    <string name="setup_guide_messages_body">汽车会显示你的消息、朗读消息，并让你回复。在打开的列表中开启 myCar。</string>
    <string name="setup_guide_aa_title">关闭 Android Auto。</string>
    <string name="setup_guide_aa_body">Android Auto 仍然安装着，它会和 myCar 争夺汽车的 USB 连接。请在打开的页面中停用或卸载它。</string>
    <string name="setup_guide_aa_open">打开 Android Auto 的应用信息</string>
    <string name="setup_guide_choose_title">选择 myCar。</string>
    <string name="setup_guide_choose_body">如果连接汽车时手机询问要打开哪个应用，请选择 myCar 并点按“始终”。</string>
    <string name="setup_guide_audio_title">车载音频。</string>
    <string name="setup_guide_audio_body">选择音乐如何传到车上。无论哪种方式，通话都通过蓝牙。</string>
    <string name="setup_guide_voice_title">语音。</string>
    <string name="setup_guide_voice_body">用语音查路线、放音乐或打电话。手机会自己把语音转成文字，你说的话不会离开手机。它需要 %1$d MB，只需下载一次。尽量使用 WLAN。</string>
    <string name="setup_guide_voice_download">下载语音</string>
    <string name="setup_guide_voice_progress">正在下载，%1$d%%。你可以继续操作，下载不会中断。</string>
    <string name="setup_guide_voice_ready">语音已就绪。</string>
    <string name="setup_guide_voice_failed">下载未完成。点按“下载语音”重试。</string>
    <string name="setup_guide_project_media_title">不再询问音频。</string>
    <string name="setup_guide_project_media_body">在手机开启 USB 调试的情况下，从电脑运行这条命令，Android 就会永久信任 myCar 处理你的音频。否则，每次行车你都要点按一次“开始”。</string>
    <string name="setup_guide_secure_settings_title">可读的通知。</string>
    <string name="setup_guide_secure_settings_body">音频传到车上时，Android 会隐藏通知的内容，就像你在共享屏幕一样。这项设置让 myCar 在行车时显示通知内容，结束后再隐藏。</string>
    <string name="setup_guide_screening_title">过滤陌生来电。</string>
    <string name="setup_guide_screening_body">把 myCar 设为你的来电显示应用，汽车就能在响铃前拒接通讯录以外的来电。如果不设置，汽车仍会显示每个来电，你可以在车上接听或拒接。</string>

    <string name="setup_audio_automatic">自动</string>
    <string name="setup_audio_recommended">推荐</string>
    <string name="setup_audio_automatic_body">汽车能通过蓝牙播放手机音乐时用蓝牙，否则通过 myCar。</string>
    <string name="setup_audio_bluetooth_body">每次行车无需确认，地图应用的语音也能传到车上。部分汽车通过蓝牙只接收通话。</string>
    <string name="setup_audio_through_mycar">通过 myCar</string>
    <string name="setup_audio_through_mycar_body">像 Android Auto 一样，通过数据线或 WLAN 传输。每次行车 Android 会请求一次共享音频。</string>

    <string name="intro_start">开始</string>
    <string name="intro_welcome_to">欢迎来到</string>
    <string name="intro_welcome_tag">alpha · 重磅版本</string>
    <string name="intro_wireless_title">无线连接。</string>
    <string name="intro_wireless_body">如果你的汽车支持无线 Android Auto，只需配对一次，数据线就可以留在家里。</string>
    <string name="intro_knobs_title">支持旋钮。</string>
    <string name="intro_knobs_body">转一转，按一下，就好了。没有触摸屏？myCar 现在也不需要了。</string>
    <string name="intro_graphene_title">保护已恢复。</string>
    <string name="intro_graphene_body">在 GrapheneOS 上，myCar 不再需要“漏洞利用防护兼容模式”（exploit protection compatibility mode）。如果你曾为 myCar 开启它，请关闭以恢复完整保护。</string>
    <string name="intro_graphene_open_settings">打开应用设置</string>
    <string name="intro_apps_title">好伙伴。</string>
    <string name="intro_apps_body">在车上好用的免费开源应用。每行第一个效果最好。点按一个即可在 GitHub 上查看。</string>
    <string name="intro_apps_maps">地图</string>
    <string name="intro_apps_music">音乐</string>
    <string name="intro_apps_podcasts">播客</string>
    <string name="intro_theme_title">你的按钮。</string>
    <string name="intro_theme_body">选择车机按钮的样式。随时可以在车机屏幕上的设置中更改。</string>
    <string name="intro_theme_search">搜索</string>
    <string name="intro_theme_play">播放</string>
    <string name="intro_theme_navigate">导航</string>
    <string name="intro_voice_title">说出来就行。</string>
    <string name="intro_voice_body">点按麦克风，或按下方向盘上的语音键，然后说话。手机会自己把语音转成文字，你说的话会留在手机上，除非你是在问自己的 Home Assistant。在车上说“%1$s”可查看完整列表。</string>
    <string name="intro_voice_body_language">点按麦克风，或按下方向盘上的语音键，然后说话。手机会自己把语音转成文字，你说的话会留在手机上，除非你是在问自己的 Home Assistant。它会用 myCar 的语言（%1$s）听你说话并回答。在车上说“%2$s”可查看完整列表。</string>
