    <string name="cert_notice_exhausted_title">你的汽车拒绝了所有证书</string>
    <plurals name="cert_notice_exhausted_text">
        <item quantity="other">myCar 已尝试了 %1$d 个证书。大约 2020 年以后生产的部分汽车会更严格地检查手机，myCar 暂时还无法连接它们。</item>
    </plurals>
    <string name="cert_notice_no_cert_title">myCar 还没有车机证书</string>
    <string name="cert_notice_no_cert_text">汽车只和持有其信任证书的手机通信。现在就获取一个，然后重新连接汽车。</string>
    <string name="cert_notice_own_refused_title">你的汽车拒绝了你自己的证书</string>
    <string name="cert_notice_own_refused_text">如要改用公开证书，请在“设置”的“证书”中移除你的证书。</string>
    <string name="cert_notice_clock_title">请检查汽车的日期</string>
    <string name="cert_notice_clock_text">汽车认为这个证书在它的日期下无效。请设置汽车的时钟，然后重新连接。</string>
