    <string name="help_title">如何连接</string>
    <string name="help_which_cars">哪些汽车可以使用</string>
    <string name="help_which_cars_text">大多数汽车都可以使用。大约从 2020 年起，有些汽车采用了更新的安全标准，会拒绝 myCar 的证书，myCar 无法在这些车上运行。</string>
    <string name="help_see_full_list">查看完整列表</string>
    <string name="help_in_the_car">在车上</string>
    <string name="help_sound_through_mycar">通过 myCar 传输声音</string>
    <string name="help_step_connect">插上数据线，或无线连接。</string>
    <string name="help_step_connect_detail">汽车连接后，myCar 会自动打开。如需无线连接，请先将手机与汽车配对，然后在主页上点按“无线连接”。</string>
    <string name="help_step_pair">通过蓝牙配对，用于通话。</string>
    <string name="help_step_pair_detail">手机与汽车配对后，通话会通过汽车播放。首次插上数据线时，myCar 会提议配对。</string>
    <string name="help_step_screening">在响铃前拒接陌生来电。</string>
    <string name="help_step_screening_detail">把 myCar 设为“来电显示和骚扰电话应用”。如果不设置，汽车仍会显示每个来电，你可以在车上接听或拒接。</string>
    <string name="help_set_up">设置</string>
    <string name="help_step_audio_prompt">不再每次行车都询问音频。</string>
    <string name="help_step_audio_prompt_detail">在手机上开启 USB 调试，连接到电脑，然后运行一次这条命令。如果跳过，每次出发时都要点按“开始”。</string>
    <string name="help_step_notifications">让通知内容保持可读。</string>
    <string name="help_step_notifications_detail">共享音频时，Android 会隐藏通知的内容。同时运行这条命令后，myCar 只会在音乐传到车上时解除隐藏。</string>
    <string name="help_tap_to_copy">点按即可复制</string>
    <string name="help_command_copied">命令已复制</string>

    <string name="cert_notice_turned_down_title">你的汽车拒绝了这个证书</string>
    <string name="cert_notice_switched_text">myCar 从现在起使用 %1$s。请重新连接汽车：重新插上数据线，或进行无线连接。</string>
    <string name="cert_notice_switched_next_text">myCar 从现在起使用下一个证书。请重新连接汽车：重新插上数据线，或进行无线连接。</string>
