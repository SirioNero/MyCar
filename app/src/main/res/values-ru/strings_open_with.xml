<?xml version="1.0" encoding="utf-8"?>
<!--
  Cinema for other apps (car/OpenInCinemaActivity.kt): a video sent with "Open with", or a link with
  "Share", opens in Cinema on the car's screen. Said on the phone, in a short message.
-->
<resources>
    <!-- The car is connected: the video plays, or the page opens, in Cinema now. -->
    <string name="open_with_opening">Открывается в Cinema на экране автомобиля.</string>
    <!-- The car is connecting: it opens once the car's screen is there. -->
    <string name="open_with_soon">Откроется в Cinema на экране автомобиля, как только автомобиль подключится.</string>
    <!-- No car connected: nothing is kept for later. -->
    <string name="open_with_no_car">myCar не подключён к автомобилю. Подключите его и отправьте это ещё раз: откроется в Cinema на экране автомобиля.</string>
    <!-- What was sent has no video and no web address (a text, a file). -->
    <string name="open_with_nothing">Здесь нет ничего, что Cinema может открыть: отправьте ему видео или ссылку на веб-страницу.</string>
    <!-- The name of a video sent without one: in the player's bar, and in "Continue" on Cinema's tiles. -->
    <string name="open_with_untitled">Видео</string>
    <!-- A page, or a video on the home network: it opens only once the driver taps Open on the car's screen. -->
    <string name="open_with_ask_in_car">myCar спросит на экране автомобиля, прежде чем открыть это в Cinema.</string>
    <!-- On the car's screen, over a page sent from the phone, above its address and the buttons Not now and Open. -->
    <string name="open_with_confirm_page">Открыть эту страницу с телефона?</string>
    <!-- On the car's screen, over a video sent from the phone whose address is on the home network. -->
    <string name="open_with_confirm_home">Открыть это видео из вашей домашней сети?</string>
</resources>
