<?xml version="1.0" encoding="utf-8"?>
<!--
  Cinema for other apps (car/OpenInCinemaActivity.kt): a video sent with "Open with", or a link with
  "Share", opens in Cinema on the car's screen. Said on the phone, in a short message.
-->
<resources>
    <!-- The car is connected: the video plays, or the page opens, in Cinema now. -->
    <string name="open_with_opening">Hissé dans Cinema, sur l’écran de bord.</string>
    <!-- The car is connecting: it opens once the car's screen is there. -->
    <string name="open_with_soon">Hissé dans Cinema, sur l’écran de bord, dès que vous montez à bord.</string>
    <!-- No car connected: nothing is kept for later. -->
    <string name="open_with_no_car">myCar n’est pas à bord du navire. Montez à bord, puis renvoyez ceci : c’est hissé dans Cinema, sur l’écran de bord.</string>
    <!-- What was sent has no video and no web address (a text, a file). -->
    <string name="open_with_nothing">Aucun butin ici pour Cinema : envoyez-lui une vidéo, ou le lien d’une page web.</string>
    <!-- A page, or a video on the home network: it opens only once the driver taps Open on the car's screen. -->
    <string name="open_with_ask_in_car">myCar demande sur l’écran de bord avant de le hisser dans Cinema.</string>
    <!-- On the car's screen, over a page sent from the phone, above its address and the buttons Not now and Open. -->
    <string name="open_with_confirm_page">Hisser cette page venue du téléphone ?</string>
    <!-- On the car's screen, over a video sent from the phone whose address is on the home network. -->
    <string name="open_with_confirm_home">Hisser cette vidéo du réseau de la maison ?</string>
</resources>
