    <string name="car_pages_layout_half_right">Half right</string>
    <!-- A strip the page's whole width on top, two quarters under it -->
    <string name="car_pages_layout_strip_top">Strip on top</string>
    <string name="car_pages_layout_strip_below">Strip below</string>
    <string name="car_pages_layout_map">Map</string>
    <string name="car_pages_layout_keeps">What the page shows stays, in order, as far as the new layout has room.</string>
    <!-- The car's settings -->
    <string name="car_pages_settings_title">Pages beside the map</string>
    <string name="car_pages_settings_explained">Swipe across Home, or tap the dots at its foot, for your pages: the weather, the agenda, the browser or a car app such as Plancia, as a whole page, halves, quarters or a mix. The pencil beside the dots changes the page in view.</string>
    <!-- The second tap, which puts the ready-made pages in place of the driver's -->
    <string name="car_pages_replace">Replace my pages</string>
    <string name="car_pages_ready_made">Ready-made pages</string>

    <!-- The weather on a page of Home (car/HomeWidgets.kt): today's highest and lowest temperature, keep them short. %1$d: degrees -->
