    <!-- Why a car app would not start, shown under "… would not start." (host/CarAppConnection.kt) -->
    <string name="car_host_service_disconnected">the app\'s service disconnected</string>
    <string name="car_host_refused_bind">the app refused to bind - host not accepted</string>
    <string name="car_host_would_not_connect">the app would not let myCar connect</string>
    <!-- %1$s: the name of an Android permission, technical -->
    <string name="car_host_needs_permission">It only accepts Google\'s own Android Auto: its service requires the permission %1$s, which myCar can\'t hold.</string>
    <string name="car_host_only_android_auto">It only accepts Google\'s own Android Auto host.</string>
    <string name="car_host_not_allowed">It only trusts hosts on its own allow-list (Google\'s Android Auto and a few others), and myCar isn\'t on it.</string>
    <string name="car_host_no_answer">It didn\'t answer myCar. Apps built for newer versions of Android Auto only run on Google\'s.</string>
    <!-- %1$s: a step of the connection, a technical name; %2$s: what the app answered -->
    <string name="car_host_step_failed">%1$s failed: %2$s</string>
    <!-- %1$s: a step of the connection, a technical name -->
    <string name="car_host_step_failed_no_reason">%1$s failed: no reason given</string>
    <!-- %1$s: a step of the connection, a technical name; %2$s: the app's own message, usually in English -->
    <string name="car_host_rejected_at">It rejected myCar as a host at %1$s: %2$s</string>
    <string name="car_host_state_error_at">It reported a state error at %1$s: %2$s</string>
    <string name="car_host_invalid_parameter_at">It reported an invalid parameter at %1$s: %2$s</string>
    <string name="car_host_failed_at">It failed at %1$s: %2$s</string>
    <!-- Technical. %1$s: the name of what the app answered -->
    <string name="car_host_bad_app_info">app info was %1$s</string>
    <!-- Technical. %1$d: the car API level the app needs; %2$d: the one myCar offers -->
    <string name="car_host_api_too_old">app needs car api %1$d, host offers %2$d</string>
    <!-- Technical. %1$s: the error's message -->
    <string name="car_host_handshake_failed">could not bundle the handshake: %1$s</string>
    <!-- Technical. %1$s: a step of the connection; %2$s: the error's name; %3$s: its message -->
    <string name="car_host_threw">%1$s threw: %2$s %3$s</string>
