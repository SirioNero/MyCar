    <string name="car_apps_pin">Pin to the dock</string>
    <string name="car_apps_unpin">Unpin from the dock</string>
    <!-- A greyed-out button. %1$d: how many apps the dock holds -->
    <plurals name="car_apps_dock_full">
        <item quantity="one">The dock is full (%1$d pinned)</item>
        <item quantity="other">The dock is full (%1$d pinned)</item>
    </plurals>
    <string name="car_apps_close">Close app</string>
