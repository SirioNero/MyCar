<?xml version="1.0" encoding="utf-8"?>
<!--
  The car's screen: Home (the map, the pages beside it and their widgets), the dock down its left,
  the app grid, the dashboard and the weather, wallpapers and button styles, and how myCar draws
  the screens of car apps (Car App Library apps such as maps) and says why one won't start.
-->
<resources>
    <!-- The car's screen as a whole (car/CarUi.kt) -->
    <!-- Shown once, before anything else on the car's screen -->
    <string name="car_ui_safety_title">Drive safely</string>
    <string name="car_ui_safety_unofficial">myCar is unofficial software: it is not made or reviewed by any carmaker, and it can fail without warning.</string>
    <string name="car_ui_safety_attention">Never interact with this screen while driving. Set the route or the song before you go, then keep your attention on the road.</string>
    <!-- Button under the warning -->
    <string name="car_ui_safety_understood">I understand</string>
    <!-- A car app that won't run under myCar. %1$s: the app's name -->
    <string name="car_ui_app_wont_start">%1$s doesn\'t work with myCar yet.</string>
    <string name="car_ui_app_wont_start_unknown">This app doesn\'t work with myCar yet.</string>
    <string name="car_ui_app_wont_start_detail">It didn\'t start. Some apps only run on Google\'s Android Auto.</string>
    <!-- Message at the foot of the screen. %1$s: the music app's name; %2$s: what the driver asked it to play -->
    <string name="car_ui_search_ignored">%1$s didn\'t play anything for “%2$s”</string>
    <!-- The same, when the music app has no name. %1$s: what the driver asked it to play -->
    <string name="car_ui_search_ignored_no_app">The music app didn\'t play anything for “%1$s”</string>
    <!-- Message at the foot of the screen, after a tap on a link of a web page that is for an app -->
    <string name="car_ui_link_opens_app">This link opens an app on the phone</string>

    <!-- The dock down the left of the car's screen (car/CarDock.kt): what its buttons are, read aloud -->
    <string name="car_dock_dashboard">Dashboard</string>
    <string name="car_dock_map">Map</string>
    <string name="car_dock_now_playing">Now playing</string>
    <string name="car_dock_next_turn">Next turn</string>
    <string name="car_dock_assistant">Voice assistant</string>
    <string name="car_dock_all_apps">All apps</string>
    <!-- From the app grid back to the map, with the music player beside it -->
    <string name="car_dock_map_and_music">Map and music</string>
    <!-- The phone's battery, under the clock: keep it short. %1$d: the percentage -->
    <string name="car_dock_battery">%1$d%%</string>

    <!-- myCar's own apps, by name, on the app grid and in the dock (car/NavApps.kt, car/CarApps.kt) -->
    <string name="car_apps_browser">Browser</string>
    <string name="car_apps_screen_sharing">Screen sharing</string>
    <string name="car_apps_phone">Phone</string>
    <string name="car_apps_vehicle_data">Vehicle data</string>
    <!-- Leaves myCar for the car's own screens -->
    <string name="car_apps_exit">Exit</string>
    <!-- The app grid (car/CarLauncher.kt) -->
    <!-- A music app with a car screen of its own too has two icons: this is the one for browsing that screen. %1$s: the app's name -->
    <string name="car_apps_browse_label">%1$s · Browse</string>
    <!-- The same, under the icon on the app grid, below the app's name: one short word -->
    <string name="car_apps_browse">Browse</string>
    <!-- Marks on an app's icon, read aloud -->
    <string name="car_apps_partial">Works only in part with myCar</string>
    <string name="car_apps_broken">Doesn\'t work with myCar</string>
