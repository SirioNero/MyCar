    <!-- %1$s: the app's name -->
    <string name="car_home_app_failed">%1$s would not start.</string>
    <!-- Button. %1$s: the app's name -->
    <string name="car_home_open_app">Open %1$s</string>

    <!-- What shares Home with the map (car/SidePane.kt) -->
    <!-- Read aloud, on the player's X -->
    <string name="car_side_close_player">Close the player</string>
    <!-- The car's settings: a title, then a row of choices -->
    <string name="car_side_title">Beside the map</string>
    <!-- One of the choices: the music player -->
    <string name="car_side_music">Music</string>
    <string name="car_side_explained">Music puts the player beside the map while something plays. An app stays beside the map; close it for the drive, and the button at the foot of the dock brings it back from the app grid.</string>

    <!-- The driver's pages on Home, beside the map's (car/HomePager.kt, car/PageLayouts.kt) -->
