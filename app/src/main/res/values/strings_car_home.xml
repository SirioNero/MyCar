    <string name="car_map_starting">Starting %1$s…</string>
    <string name="car_map_starting_unknown">Starting the map…</string>
    <string name="car_map_failed_unknown">The map app would not start.</string>
    <string name="car_map_choose_another">Choose another app</string>
    <string name="car_map_none_installed">No mapping apps found.</string>
    <string name="car_map_none_installed_detail">Install a navigation app that supports Android Auto and it will start here on its own.</string>
