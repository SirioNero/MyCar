    <string name="car_map_stopped">Map stopped.</string>
    <string name="car_map_reopen">Reopen</string>
    <!-- Button: opens the app grid -->
    <string name="car_map_car_apps">Car apps</string>
    <string name="car_map_choose">Choose a map app.</string>
