    <!-- Usage notes, the opt-in stats, in setup and Settings (ui/UsageStatsChoices.kt). %1$s: the privacy promise (stats_intro_privacy), shown in bold -->
    <string name="stats_intro">Turn this on, and myCar sends a short note when you open it and after each drive. %1$s The notes show which cars work and where the others fail.</string>
