    <!-- Tailscale, on the phone and in the car (Tailnet.kt). "Settings, App split tunneling" and "Use Tailscale DNS": the Tailscale app's own words. %1$s: the server's name, like umbrel -->
    <string name="tailscale_leaves_mycar_out">Tailscale leaves myCar out, so “%1$s” on your tailnet is out of its reach. In Tailscale on the phone: Settings, App split tunneling, let myCar in - and connect the car with the cable: inside a VPN, Android keeps myCar off the car\'s Wi-Fi.</string>
    <!-- %1$s: the server's name -->
    <string name="tailscale_name_not_found">“%1$s” isn\'t found from here. If it\'s a Tailscale name, turn Tailscale on: myCar reaches it only through Tailscale.</string>
    <!-- %1$s: the server's name -->
    <string name="tailscale_name_unknown">Tailscale doesn\'t know “%1$s”: check the name, and that Use Tailscale DNS is on in Tailscale.</string>
    <!-- Settings > Plancia and Xonos, with the server on a tailnet (ui/TailscaleCableRow.kt). %1$s: the app, Plancia or Xonos -->
    <string name="tailscale_bridged_title">Through Tailscale: through the %1$s app too</string>
    <!-- %1$s: the server, Home Assistant or Music Assistant; %2$s: the app, Plancia or Xonos -->
    <string name="tailscale_bridged_detail">Wirelessly, with myCar left out of Tailscale (inside a VPN, Android keeps myCar off the car\'s Wi-Fi), myCar reaches your %1$s through the %2$s app, which is inside Tailscale. Keep the %2$s app set up with the same address.</string>
    <string name="tailscale_cable_title">Through Tailscale: with the cable, for now</string>
    <!-- %1$s: the server, Home Assistant or Music Assistant; %2$s: the app, Plancia or Xonos, which is on the phone -->
    <string name="tailscale_cable_update_app">Wirelessly, myCar has to be left out of Tailscale (inside a VPN, Android keeps myCar off the car\'s Wi-Fi), and then it can\'t reach your %1$s by itself. Update the %2$s app, and myCar reaches it through the app; until then the car uses the %2$s app instead, by itself.</string>
    <!-- %1$s: the server, Home Assistant or Music Assistant; %2$s: the app, Plancia or Xonos, which isn't on the phone -->
    <string name="tailscale_cable_get_app">Wirelessly, myCar has to be left out of Tailscale (inside a VPN, Android keeps myCar off the car\'s Wi-Fi), and then it can\'t reach your %1$s by itself. With an up-to-date %2$s app on the phone, myCar reaches it through the app.</string>
