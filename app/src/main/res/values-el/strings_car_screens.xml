    <string name="car_settings_car_audio_through_mycar">Μέσω του myCar</string>
    <string name="car_settings_car_audio_note">Το «Μέσω του myCar» στέλνει τον ήχο του τηλεφώνου από τη σύνδεση του ίδιου του myCar, το καλώδιο ή το Wi-Fi, όπως το Android Auto. Το Android ζητά κοινή χρήση της οθόνης σας σε κάθε διαδρομή, και λίγες εφαρμογές το εμποδίζουν. Το Bluetooth παίζει όπως θα έπαιζε κανονικά το τηλέφωνο και το Android δεν ρωτά ποτέ, αλλά μερικά αυτοκίνητα δέχονται από εκεί μόνο κλήσεις. Το «Αυτόματα» χρησιμοποιεί το Bluetooth όταν το αυτοκίνητο παίρνει έτσι τη μουσική του τηλεφώνου, και τη σύνδεση του myCar όταν δεν την παίρνει.</string>
    <string name="car_settings_bluetooth_warning">Προειδοποίηση χωρίς Bluetooth</string>
    <string name="car_settings_location_warning">Προειδοποίηση χωρίς τοποθεσία</string>
    <string name="car_settings_spoken_directions">Φωνητικές οδηγίες</string>
    <string name="car_settings_spoken_directions_note">Το myCar διαβάζει δυνατά κάθε στροφή από τα ηχεία του αυτοκινήτου, και η μουσική χαμηλώνει όσο μιλά. Απενεργοποιήστε το αν η φωνή της εφαρμογής χαρτών σας ακούγεται ήδη στο αυτοκίνητο.</string>
    <string name="car_settings_system_speech">Αναγνώριση ομιλίας του τηλεφώνου</string>
    <string name="car_settings_system_speech_note">Ακούει μέσω της υπηρεσίας ομιλίας του ίδιου του τηλεφώνου αντί για αυτή του myCar. Στα περισσότερα τηλέφωνα είναι αυτή της Google, που μπορεί να στέλνει τη φωνή σας στη Google. Το GrapheneOS δεν έχει καμία, οπότε το myCar συνεχίζει με τη δική του.</string>
    <string name="car_settings_experimental">Πειραματικές λειτουργίες</string>
    <string name="car_settings_experimental_hide">Απόκρυψη</string>
