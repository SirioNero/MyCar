<?xml version="1.0" encoding="utf-8"?>
<!--
  Cinema for other apps (car/OpenInCinemaActivity.kt): a video sent with "Open with", or a link with
  "Share", opens in Cinema on the car's screen. Said on the phone, in a short message.
-->
<resources>
    <!-- The car is connected: the video plays, or the page opens, in Cinema now. -->
    <string name="open_with_opening">Hoisting it in Cinema, at the helm.</string>
    <!-- The car is connecting: it opens once the car's screen is there. -->
    <string name="open_with_soon">It sails into Cinema, at the helm, as soon as you board the ship.</string>
    <!-- No car connected: nothing is kept for later. -->
    <string name="open_with_no_car">myCar isn\'t aboard the ship. Board it, then send this again: it sails into Cinema, at the helm.</string>
    <!-- What was sent has no video and no web address (a text, a file). -->
    <string name="open_with_nothing">No plunder here for Cinema: send it a video, or a link to a web page.</string>
</resources>
